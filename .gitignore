# 忽略产物与缓存
out/
out-*/
__pycache__/
*.pyc
*.pyo

# 打包/构建产物
build/
dist/
*.egg-info/

# 凭据绝不能进仓库（正常情况它根本不在项目目录里，这里只是兜底）
credential.json
.env

# 可选组件（本地 ASR）的本地安装与缓存：属于本机环境，不进仓库
.venv-asr/
.venv/
.cache/

# 本地 ASR 下载的模型权重（如果被指到项目目录里）
models/

# 测试用的临时目录
tests/.tmp/

# 内部调研笔记（设计依据在本 README 内已完整复述，笔记本身不对外发布）
research/

# 本机排障脚本（含本机路径与硬件细节，不对外发布）
# 注意：必须写成 `tools/*` 而非 `tools/` —— 目录整体被排除时，其下的 `!` 例外
# 会被 Git 忽略（re-include 对已排除目录的子文件无效）。
tools/*
# 例外：GPU 是否真的可用的判据脚本，README 与 bilibili-summary Skill 都引用它
!tools/cuda_dll_check.py
